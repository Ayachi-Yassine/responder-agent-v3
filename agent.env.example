AGENT_API_KEY=changeme_use_openssl_rand_hex_32
AGENT_HOST=0.0.0.0
AGENT_PORT=9100
AGENT_LOG_FILE=/var/log/responder-agent.log

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/openai/gpt-oss-20b

# true  -> log decisions without executing (safe for first run)
# false -> actually execute block/kill/command
DRY_RUN=true

# How often the self-monitoring loop scans the system (seconds)
SCAN_INTERVAL=15

# SSH brute force: how many failures from one IP within SSH_FAIL_WINDOW
# seconds before the AI is triggered
SSH_FAIL_WINDOW=60
SSH_FAIL_THRESH=5
